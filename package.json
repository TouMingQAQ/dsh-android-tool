{
  "name": "dsh-android-tool",
  "version": "0.1.1",
  "description": "把 Android 设备接进 DSH：设置页配置无线调试与 adb，右侧四 Tab 看画面 / Logcat / 性能 / 指令，并给 AI android_view / android_state / android_control / android_adb 四个工具",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scrcpy-win64-v5.0.1"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "android",
    "adb",
    "scrcpy",
    "logcat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TouMingQAQ/dsh-android-tool.git"
  },
  "homepage": "https://github.com/TouMingQAQ/dsh-android-tool#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@yume-chan/scrcpy": "^3.0.0-beta.4"
  }
}
